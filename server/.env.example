NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
APP_PRIMARY_DOMAIN=127.0.0.1

# 数据库二选一
# 1) 直接使用 DATABASE_URL
# DATABASE_URL=mysql://root:your-password@127.0.0.1:3306/campus_market

# 2) 或者拆分 MYSQL_*
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=campus_market
MYSQL_CONNECTION_LIMIT=10

# 安全与管理员初始化
JWT_SECRET=change-this-long-random-jwt-secret
ADMIN_BOOTSTRAP_KEY=change-this-long-random-bootstrap-key

# 邮件
EMAIL_PROVIDER=console
EMAIL_CODE_SECRET=change-this-long-random-email-code-secret
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_SENDER_NAME=校园集市
# EMAIL_SMTP_HOST=smtp.qiye.aliyun.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USER=service@example.com
# EMAIL_SMTP_PASS=change-this-smtp-password-or-auth-code
# EMAIL_FROM=service@example.com
# EMAIL_SMTP_REJECT_UNAUTHORIZED=true
# EMAIL_SMTP_TIMEOUT_MS=15000

# 上传
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PREFIX=/uploads
UPLOAD_MAX_BODY_SIZE=20m
